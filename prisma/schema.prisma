// =====================================================
// Talib | طالب - Prisma Schema
// =====================================================
// Mirrors the Android Room schema + adds the missing "cohorts" table (fix A.2)
// + adds "semester" field to ModuleCourse (fix B.3)
// + adds "scheduleImage" fields to StudentProfile (fix B.4)
// + adds "isCompleted" local flag to Assignment (per-student, fix B.6)
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================
// 0. المؤسسات الجامعية
// =====================================================
model Institution {
  id          Int      @id @default(autoincrement())
  nameAr      String
  type        String   @default("المدرسة العليا للأساتذة")
  city        String   @default("الجزائر")
  specialties Specialty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Specialty {
  id             Int            @id @default(autoincrement())
  institutionId  Int
  nameAr         String
  code           String
  iconName       String         @default("book")
  description    String         @default("")
  institution    String         @default("المدرسة العليا للأساتذة - بوزريعة")
  faculty        String         @default("قسم اللغة والأدب العربي")
  institutionRef Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYears  AcademicYear[]
  cohortGroups   CohortGroup[]
  studyGroups    StudyGroup[]
  modules        ModuleCourse[]
  appUsers       AppUser[]
  announcements Announcement[]
  academicTracks AcademicTrack[] // NEW: relation back to AcademicTrack

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id           Int            @id @default(autoincrement())
  specialtyId  Int
  yearName     String
  semester     Int            @default(1)
  specialty    Specialty      @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  cohortGroups CohortGroup[]
  studyGroups  StudyGroup[]
  modules      ModuleCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 0.1 الأفواج الدراسية (Cohort Groups) — منفصل ومستقل (fix A.2)
// + trackId لربط الفوج بالملمح الأكاديمي (matching new Android source)
// =====================================================
model CohortGroup {
  id              Int           @id @default(autoincrement())
  specialtyId     Int
  academicYearId  Int
  trackId         Int?          // NEW: link to academic track (PEP/PEM/PES/etc.)
  groupId         Int?          // fix ب: cohort belongs to a StudyGroup (المجموعة)
  groupName       String // "الفوج 01", "الفوج 02"...
  subGroup        String        @default("")
  createdAt       DateTime      @default(now())
  specialty       Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  track           AcademicTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)
  group           StudyGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  appUsers        AppUser[]
  joinRequests    JoinRequest[]

  updatedAt DateTime @updatedAt

  @@unique([specialtyId, academicYearId, groupName])
}

// =====================================================
// 0.3 المجموعات الدراسية (Study Groups) — fix ب
// الفوج ينتمي لمجموعة، والمجموعة تنتمي لمؤسسة+تخصص+سنة
// RESTORED (round 3): was accidentally dropped by the AI-cleanup commit
// =====================================================
model StudyGroup {
  id             Int            @id @default(autoincrement())
  specialtyId    Int
  academicYearId Int
  trackId        Int?
  groupName      String
  description    String         @default("")
  createdAt      DateTime       @default(now())
  specialty      Specialty      @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  track          AcademicTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)
  cohorts        CohortGroup[]
  appUsers       AppUser[]

  updatedAt DateTime @updatedAt
}

// =====================================================
// 19. طلبات الانضمام للأفواج (Join Requests)
// الطلب يرسله الطالب ويوافق عليه الممثل/المشرف
// RESTORED (round 3): was accidentally dropped by the AI-cleanup commit
// =====================================================
model JoinRequest {
  id           Int         @id @default(autoincrement())
  requesterId  Int
  cohortId     Int
  groupId      Int?
  status       String      @default("pending") // pending | approved | rejected
  message      String      @default("")
  reviewerId   Int?
  reviewerNote String      @default("")
  requester    AppUser     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  cohort       CohortGroup @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

// =====================================================
// 0.2 الملامح الأكاديمية (Academic Tracks) — NEW from updated Android source
// Represents tracks like PEP (primary), PEM (middle), PES (secondary), etc.
// =====================================================
model AcademicTrack {
  id          Int       @id @default(autoincrement())
  specialtyId Int
  trackNameAr String    // "أستاذ التعليم الابتدائي (PEP)" etc.
  code        String    // "PEP", "PEM", "PES", "INF-GEN", "ISIL"
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  cohorts     CohortGroup[]
  studyGroups StudyGroup[]
  appUsers    AppUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([specialtyId, code])
}

// =====================================================
// 1. المقررات
// =====================================================
model ModuleCourse {
  id                   Int              @id @default(autoincrement())
  specialtyId          Int
  academicYearId       Int
  semester             Int              @default(1) // fix B.3: 1 | 2
  name                 String
  code                 String
  coefficient          Float            @default(2.0)
  credits              Int              @default(4)
  professorName        String           @default("")
  professorEmail       String           @default("")
  category             String           @default("أساسي")
  description          String           @default("")
  syllabusTopics       String           @default("")
  visibilityScope      String           @default("تخصص كامل")
  targetGroup          String           @default("الكل")
  specialty            Specialty        @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  academicYear         AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  lectures             Lecture[]
  assignments         Assignment[]
  exams                Exam[]
  grades               StudentGrade[]
  cachedMaterials      CachedCourseMaterial[]
  lastViewedTimestamp  Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 2. المحاضرات
// =====================================================
model Lecture {
  id                  Int      @id @default(autoincrement())
  moduleId            Int
  weekNumber          Int
  title               String
  summary             String
  pdfFileName         String   @default("lecture_notes.pdf")
  pdfUrl              String   @default("")
  pdfStoragePath      String   @default("") // Supabase Storage path (fix A.5)
  durationMinutes     Int      @default(90)
  date                String   @default("")
  isBookmarked        Boolean  @default(false)
  isDownloaded        Boolean  @default(false)
  isCachedOffline     Boolean  @default(true)
  isRead              Boolean  @default(false)
  lastViewedTimestamp Int      @default(0)
  cachedContentText   String   @default("")
  visibilityScope     String   @default("تخصص كامل")
  targetGroup         String   @default("الكل")
  authorName          String   @default("الممثل")
  module              ModuleCourse @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CachedCourseMaterial {
  id                  Int      @id @default(autoincrement())
  moduleId            Int
  moduleName          String
  title               String
  materialType        String   @default("محاضرة")
  summary             String
  fullText            String
  keyConcepts         String   @default("")
  weekNumber          Int      @default(1)
  cachedDate          String   @default("مخزن محلياً")
  lastViewedTimestamp Int      @default(0)
  isOfflineAvailable  Boolean  @default(true)
  module              ModuleCourse @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 3. الواجبات (مع isCompleted محلي لكل طالب - fix B.6)
// =====================================================
model Assignment {
  id              Int           @id @default(autoincrement())
  moduleId        Int
  title           String
  dueDate         String
  description     String
  maxScore        Float         @default(20.0)
  visibilityScope String        @default("تخصص كامل")
  targetGroup     String        @default("الكل")
  module          ModuleCourse  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  // Local per-student completion status (stored as JSON string: {"studentId": true})
  studentCompletions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 4. الجدول الأسبوعي
// =====================================================
model ScheduleItem {
  id              Int      @id @default(autoincrement())
  specialtyId     Int
  academicYearId  Int
  cohortId        Int?     // fix A.2: link to real cohort, not hardcoded "3"
  dayOfWeek       Int     // 1: Sun, 2: Mon, 3: Tue, 4: Wed, 5: Thu
  startTime       String
  endTime         String
  moduleName      String
  type            String  // محاضرة / TD / TP
  room            String
  professor       String
  visibilityScope String  @default("تخصص كامل")
  targetGroup     String  @default("الكل")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// round 27 (review §7): the PERSONAL timetable — classes a student adds for
// themselves (day/time/course/location/notes). Per-user data, deliberately
// a separate table from ScheduleItem (which stays the OFFICIAL specialty
// schedule managed by supervisors) so the two can never be confused.
model PersonalScheduleItem {
  id         Int     @id @default(autoincrement())
  userId     Int
  dayOfWeek  Int     // 1: Sun .. 5: Thu (same convention as ScheduleItem)
  startTime  String
  endTime    String  @default("")
  moduleName String
  type       String  @default("محاضرة") // محاضرة / TD / TP
  room       String  @default("")       // المكان / القاعة
  notes      String  @default("")       // optional personal notes (review §7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// =====================================================
// 5. الامتحانات
// =====================================================
model Exam {
  id              Int           @id @default(autoincrement())
  moduleId        Int
  moduleName     String
  title          String
  examDate       String
  time           String
  room           String
  coefficient     Float         @default(2.0)
  isFinished     Boolean       @default(false)
  visibilityScope String        @default("تخصص كامل")
  targetGroup     String        @default("الكل")
  module          ModuleCourse  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 6. العلامات
// =====================================================
model StudentGrade {
  id              Int           @id @default(autoincrement())
  moduleId        Int
  moduleName      String
  continuousScore Float         @default(14.0)
  examScore       Float         @default(15.0)
  coefficient      Float         @default(2.0)
  credits          Int           @default(4)
  isOfficial      Boolean       @default(false)
  targetScore     Float         @default(10.0)
  module          ModuleCourse  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  ownerId         String        @default("local")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 7. الإعلانات
// =====================================================
model Announcement {
  id              Int      @id @default(autoincrement())
  title           String
  content         String
  author          String
  date            String
  urgency         String   @default("عام")
  specialtyId     Int?
  isRead          Boolean  @default(false)
  visibilityScope String   @default("تخصص كامل")
  targetGroups    String   @default("الكل")
  specialty       Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 8. ملف الطالب (StudentProfile)
// - Local per-device profile (synced with Supabase auth)
// - includes scheduleImage for fix B.4
// =====================================================
model StudentProfile {
  id                Int      @id @default(1) // singleton per device
  userId            String   @default("local")
  fullName          String
  email             String
  studentId         String   @default("") // auto-generated (fix B.1)
  institution       String   @default("")
  university        String   @default("")
  faculty           String   @default("")
  specialtyName     String   @default("")
  profileTrack      String   @default("")
  trackId           Int?     // NEW: link to AcademicTrack
  selectedSpecialtyId Int   @default(1)
  selectedYearId    Int      @default(1)
  selectedCohortId  Int?     // fix A.2: link to real cohort
  academicYearName  String   @default("")
  semesterName      String   @default("")
  groupNumber       String   @default("")
  subGroup          String   @default("")
  isAdminMode       Boolean  @default(false)
  userRole          String   @default("STUDENT")
  themePalette      String   @default("ACADEMIC")
  isConfigured      Boolean  @default(false)
  // fix B.4: per-student schedule image
  scheduleImageMode String   @default("manual") // "manual" | "image"
  scheduleImagePath String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 9. ملاحظات الطالب
// =====================================================
model StudentNote {
  id         Int      @id @default(autoincrement())
  ownerId    String   @default("local")
  title      String
  content    String
  moduleName String   @default("عام")
  createdAt  String   @default("اليوم")
  colorHex   String   @default("#1B5E4B")

  createdDateTime DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 10. كتب ومراجع المكتبة
// =====================================================
model LibraryReference {
  id              Int      @id @default(autoincrement())
  specialtyId     Int      @default(1)
  title           String
  author          String
  category        String   @default("كتاب مرجعي")
  description     String
  fileFormat      String   @default("PDF")
  pageCount       Int      @default(250)
  downloadUrl     String   @default("")
  isSavedOffline  Boolean  @default(true)
  visibilityScope String   @default("تخصص كامل")

  // round 32 — نشر إلى المكتبة: when a supervisor publishes a file from
  // their own Google Drive, the bytes live in Drive (15 GB, not Supabase);
  // these optional columns keep the size for display + the Drive fileId so
  // the publisher can clean the Drive copy when removing the library entry.
  fileSize        Int?     // bytes
  storagePath     String?  // Google Drive fileId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 11. التقويم الأكاديمي
// =====================================================
model AcademicCalendarEvent {
  id          Int      @id @default(autoincrement())
  title       String
  eventType   String   @default("محطة رسمية")
  startDate   String
  endDate     String   @default("")
  description String   @default("")
  isCurrent   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 12. سجل الحضور والغيابات
// =====================================================
model AttendanceRecord {
  id                Int      @id @default(autoincrement())
  ownerId           String   @default("local")
  moduleName        String
  sessionType       String   @default("أعمال موجهة TD")
  date              String
  status            String   @default("غائب")
  reason            String   @default("")
  maxAllowedAbsences Int     @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 13. تبليغات الطلاب
// =====================================================
model StudentIssueReport {
  id               Int      @id @default(autoincrement())
  studentName      String
  studentGroup     String
  itemType         String
  itemTitle        String
  description      String
  date             String
  status           String   @default("قيد المراجعة")
  representativeNote String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 14. استطلاعات الرأي
// =====================================================
model ClassPoll {
  id              Int      @id @default(autoincrement())
  creatorName     String
  question        String
  optionA         String
  votesA          Int      @default(0)
  optionB         String
  votesB          Int      @default(0)
  optionC         String   @default("")
  votesC          Int      @default(0)
  userVotedOption String?  // null = not voted
  targetGroup     String   @default("الكل")
  isClosed        Boolean  @default(false)
  createdAt       String   @default("اليوم")

  createdDateTime DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 14.5 دروس تيليجرام (Telegram Lessons) — round 7
// telegram_sources = قنوات/مجموعات مربوطة بالبوت، مرتبطة
// بالتسلسل الأكاديمي (سنة/سداسي/مقياس) أو بفوج محدد (مساحة مشتركة).
// telegram_items  = المنشورات المستوردة (روابط فقط، لا ملفات)
// =====================================================
model TelegramSource {
  id            Int      @id @default(autoincrement())
  tgChannelId   String   @unique // chat id من تيليجرام (-100… للقنوات/المجموعات)
  tgUsername    String   @default("") // @username للقنوات العامة (يبني روابط t.me)
  titleAr       String // اسم للعرض داخل التطبيق
  sourceType    String   @default("channel") // channel (قناة) | group (مجموعة فوج)
  kind          String   @default("public") // public | private
  institutionId Int?
  specialtyId   Int
  trackId       Int?
  yearId        Int?
  semester      Int?
  moduleId      Int? // الربط بالمقياس (للنوع channel)
  cohortId      Int? // الربط بالفوج (للنوع group — مساحة مشتركة)
  isActive      Boolean  @default(true) // إيقاف الاستيراد مؤقتاً
  lastUpdateId  Int      @default(0)
  items         TelegramItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TelegramItem {
  id           Int      @id @default(autoincrement())
  sourceId     Int? // NULL = إضافة يدوية داخل المساحة المشتركة
  source       TelegramSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tgMessageId  Int      @default(0) // 0 = ليس منشور تيليجرام
  mediaGroupId String   @default("") // تجميع صور الألبوم الواحد
  kind         String   @default("text") // pdf|doc|ppt|image|video|audio|text|link|other
  titleAr      String   @default("")
  captionText  String   @default("")
  searchText   String   @default("") // نسخة مُطبَّعة (بدون تشكيل) للبحث
  fileName     String   @default("")
  mimeType     String   @default("")
  fileId       String   @default("") // لعرض الصور عبر الوكيل
  fileUniqueId String   @default("") // كشف التكرار
  sizeBytes    Int      @default(0)
  link         String // رابط t.me المباشر للمنشور الأصلي
  specialtyId  Int      @default(1)
  moduleId     Int?
  itemType     String   @default("محاضرة") // محاضرة|أعمال موجهة TD|تمارين|امتحان|ملخص|كتاب|إعلان|عام
  origin       String   @default("telegram") // telegram | manual
  postedBy     String   @default("")
  cohortId     Int? // مساحة الفوج المشتركة
  isHidden     Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  aiClassified Boolean  @default(false) // صُنِّف عبر Gemini
  postedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, tgMessageId])
  @@index([moduleId])
  @@index([cohortId])
  @@index([specialtyId])
}

// =====================================================
// 15. مستخدمو النظام (AppUser) - مع RBAC كامل
// fix A.1: introduce supervisoryScopeEnforced flag
// =====================================================
model AppUser {
  id                    Int      @id @default(autoincrement())
  supabaseUserId        String?  @unique // link to Supabase auth
  fullName              String
  email                 String   @unique
  studentId             String
  passwordHash          String   @default("") // empty = no password (fix B.1)
  specialtyName         String
  yearName              String
  groupNumber           String
  role                  String   @default("STUDENT") // STUDENT | REPRESENTATIVE | SPECIALTY_ADMIN | OWNER
  // Supervisory scope — if role is REPRESENTATIVE/SPECIALTY_ADMIN, MUST be non-empty
  representativeScope   String   @default("فوج واحد") // فوج واحد | سنة كاملة | تخصص كامل
  assignedSpecialtyId   Int      @default(1)
  scopeInstitutionId    Int?
  scopeSpecialtyId      Int?
  scopeAcademicYearId   Int?
  scopeCohortGroupId    Int?
  scopeTrackId          Int?     // NEW: track-level scope (PEP/PEM/PES)
  scopeGroupId          Int?     // study-group-level scope (restored round 3)
  specialty             Specialty? @relation(fields: [assignedSpecialtyId], references: [id])
  cohortGroup           CohortGroup? @relation(fields: [scopeCohortGroupId], references: [id])
  track                 AcademicTrack? @relation(fields: [scopeTrackId], references: [id], onDelete: SetNull)
  scopeGroup            StudyGroup?   @relation(fields: [scopeGroupId], references: [id], onDelete: SetNull)
  joinRequestsMade      JoinRequest[]
  deviceSessions        DeviceSession[]
  contentUploads        ContentUploadLog[]
  notificationReads    NotificationReadState[]
  appNotifications     AppNotification[]
  notificationPref      NotificationPref?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// 15b. إشعارات التطبيق (AppNotification) - round 10, review §3/§4
// Real per-user notifications (join-request outcomes, new requests
// awaiting review, new student reports) — distinct from announcement
// read states. Server-side inserts only; users read/mark-read their own.
// =====================================================
model AppNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String    // "join_new" | "join_approved" | "join_rejected" | "report_new" | "generic" | "content_*" | "exam_reminder" | "assignment_reminder"
  title     String
  body      String    @default("")
  meta      String    @default("{}") // JSON string: { requestId, cohortId, examId, urgency, ... }
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, type, createdAt])
}

// =====================================================
// 15c. تفضيلات الإشعارات (NotificationPref) - round 24
// Per-user notification preferences: which CATEGORIES are muted.
// Stored as a JSON array string of category names. Transactional
// outcomes (join_approved / join_rejected) are NEVER muted — they
// are the result of the user's own action, not ambient news.
// =====================================================
model NotificationPref {
  userId     Int      @id
  mutedTypes String   @default("[]") // JSON array: ["announcements", "reminders", ...]
  updatedAt  DateTime @default(now()) @updatedAt
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================
// 16. جلسات الأجهزة (Device Sessions) - fix B.1: "remember device"
// =====================================================
model DeviceSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  deviceToken  String   @unique // random secure token
  userAgent    String   @default("")
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =====================================================
// 17. سجل رفع المحتوى (Content Upload Queue) - fix A.3 + A.5
// Tracks where content was saved + cloud upload status
// =====================================================
model ContentUploadLog {
  id             Int      @id @default(autoincrement())
  contentType    String   // "lecture" | "exam" | "announcement" | "assignment"
  targetTable    String   // "lectures" | "exams" | "announcements" | "assignments"
  title          String
  uploadedById   Int
  cloudStatus    String   @default("pending") // "pending" | "uploaded" | "failed"
  cloudUrl       String   @default("")
  errorMessage   String   @default("")
  payload        String   @default("{}") // JSON snapshot of saved data
  uploadedBy     AppUser  @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// =====================================================
// 18. عداد الإشعارات (NotificationReadState) - fix B.8
// =====================================================
model NotificationReadState {
  id              Int      @id @default(autoincrement())
  userId          Int
  announcementId  Int
  readAt          DateTime @default(now())
  user            AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
}
